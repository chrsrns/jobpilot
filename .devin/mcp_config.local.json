{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--snapshot-mode",
        "none",
        "--user-data-dir",
        ".playwright-mcp"
      ]
    },
    "upwork": {
      "url": "https://mcp.upwork.com/mcp",
      "transport": "http"
    }
  }
}